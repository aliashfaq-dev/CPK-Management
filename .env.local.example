# Copy to .env.local and fill in. Server-only: none of these may ever get a NEXT_PUBLIC_ prefix.
# Only variable names are committed here, never values.

# Postgres. Neon: the pooled connection string (add ?sslmode=require). Local Docker: postgres://user:pass@127.0.0.1:5432/db
DATABASE_URL=
# Direct (non-pooled) URL. Needed for LISTEN/NOTIFY on Neon; falls back to DATABASE_URL when empty.
DATABASE_URL_DIRECT=

# Detection pipeline service (default http://127.0.0.1:8000). Leave PIPELINE_URL empty to run without a pipeline.
# The pipeline's VIDEO_DIR should point at this project's public/videos folder.
PIPELINE_URL=
PIPELINE_TOKEN=

# Sessions: at least 32 random characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
# Used once to create the first admin when app_users is empty.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Assistant (Gemini). GEMINI_MODEL defaults to a current flash model when empty.
GEMINI_API_KEY=
GEMINI_MODEL=

# S3-compatible object storage holding the event images (Neon storage or local MinIO, path-style).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
S3_BUCKET=

# Set to 1 to also expose /api/live/pipeline-events (pipeline /ws/events proxied as SSE).
LIVE_PIPELINE_EVENTS=
